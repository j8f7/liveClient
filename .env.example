# Copy to .env and edit. Values are baked into the build (npm run build).
# Server address as browsers reach it (no trailing slash). Empty = same host as the page.
# Shanghai server (default). Tokyo: https://xn--fjqz24bfqeo5p.xyz/watchparty
VITE_SERVER_HOST=https://1.xn--lcy176c.app:5999/watchparty
# Room opened at "/" instead of the lobby; empty = show the lobby.
VITE_DEFAULT_ROOM=
# true = hash routes (#/watch/room) for hosts that serve the app from a sub-path
# (e.g. feishuapp.com/app/<id>) and can't send deep links to index.html.
VITE_HASH_ROUTER=false
# Dev only: port of a local server (used when VITE_SERVER_HOST is empty).
PORT=8080
# Leave blank to run without login.
VITE_FIREBASE_CONFIG=
